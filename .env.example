# Public client configuration only. Never put a service_role/sb_secret key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_AUTH_GOOGLE_ENABLED=false
EXPO_PUBLIC_AUTH_FACEBOOK_ENABLED=false

# Optional. Without this key the Android demo opens without the native map.
GOOGLE_MAPS_API_KEY=
